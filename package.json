{
  "name": "server",
  "version": "1.0.0",
  "description": "Femmeflo seller, manager and inventory management backend",
  "homepage": "https://github.com/SevenX-Labs/femmeflo-yfa-inventory-server#readme",
  "bugs": {
    "url": "https://github.com/SevenX-Labs/femmeflo-yfa-inventory-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SevenX-Labs/femmeflo-yfa-inventory-server.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc -p tsconfig.check.json",
    "pretest": "prisma generate",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "prisma generate && tsx --test tests/integration/*.test.ts",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:bootstrap-admin": "tsx prisma/seed.ts",
    "docs:api": "node scripts/generate-api-docs.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
