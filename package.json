{
  "name": "server",
  "version": "1.0.0",
  "description": "Femmeflo seller, manager and inventory management backend",
  "homepage": "https://github.com/SevenX-Labs/femmeflo-yfa-inventory-server#readme",
  "bugs": {
    "url": "https://github.com/SevenX-Labs/femmeflo-yfa-inventory-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SevenX-Labs/femmeflo-yfa-inventory-server.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc -p tsconfig.check.json",
    "pretest": "prisma generate",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:integration": "prisma generate && tsx --test tests/integration/*.test.ts",
    "test:postman": "prisma generate && tsx scripts/test-postman.ts",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:bootstrap-admin": "tsx prisma/seed.ts",
    "admin:reset": "tsx scripts/reset-admin.ts",
    "docs:api": "node scripts/generate-api-docs.mjs",
    "db:clean": "tsx scripts/clean-database.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/supabase-js": "^2.117.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/sharp": "^0.31.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}