NODE_ENV=development
PORT=5000
# Comma-separated web and mobile app origins (supports http, https, capacitor://localhost, ionic://localhost, or *)
CORS_ORIGINS=http://localhost:3000,capacitor://localhost,ionic://localhost,http://localhost

# Development Supabase PostgreSQL connection URL. Never commit real credentials.
DATABASE_URL=postgresql://user:password@localhost:5432/femmeflo_dev
# Optional direct/session connection for migrations if runtime uses a pooler.
DIRECT_DATABASE_URL=
JWT_SECRET=super_secret_jwt_signing_key_min_32_characters_here
JWT_EXPIRES_IN=30d

# Supabase Storage Configuration (Customer Storefront Photos)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_CUSTOMER_BUCKET=customer-photos
MAX_PHOTO_SIZE_MB=5

# Email Provider Configuration (Resend)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@femmeflo.com

# WhatsApp Provider Configuration (Twilio or MSG91)
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=+14155238886

# Alternative WhatsApp Provider: MSG91
# WHATSAPP_PROVIDER=msg91
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_INTEGRATED_NUMBER=919876543210

# Notification Delivery Retry Configuration
NOTIFICATION_MAX_RETRIES=3

# Used only by npm run db:bootstrap-admin; remove ADMIN_PASSWORD after bootstrap.
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@femmeflo.in

# Development-only direct/session URL. Integration tests create/remove their own schema.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/femmeflo_test
